{
  "description": "Intercept plan mode exit for inline review via drover",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "drover plan-hook",
            "timeout": 345600
          }
        ]
      }
    ]
  }
}
